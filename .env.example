# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Model for note writing / quizzes / grading (default claude-sonnet-5-5)
NOTETHING_MODEL=claude-sonnet-5-5
# Cheap model for file classification (default claude-haiku-4-5)
NOTETHING_CHEAP_MODEL=claude-haiku-4-5

# AgentMail (https://agentmail.to)
AGENTMAIL_API_KEY=
# Inbox id/address to send from. Leave blank and run `pnpm inbox` to create one.
AGENTMAIL_INBOX=
# Where study sessions are emailed
STUDENT_EMAIL=
# Your name, so files like Jane_Doe_PS1.pdf are recognized as your own submitted work
STUDENT_NAME=

# Neon Postgres connection string
DATABASE_URL=

# Obsidian vault output dir (default ./vault). Point at a real vault to see notes live.
VAULT_DIR=
# Local hour (0-23) study sessions are scheduled for
STUDY_HOUR=18

# Lecture videos are transcribed locally with uv + faster-whisper by default.
# Optional: transcribe on a remote box over SSH instead (python with faster-whisper + yt-dlp there)
TRANSCRIBE_SSH_HOST=
TRANSCRIBE_PYTHON=~/notething-venv/bin/python
WHISPER_MODEL=small
