# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Model for note writing / quizzes / grading (default openai/gpt-6-luna). Must accept image + file input.
NOTETHING_MODEL=openai/gpt-6-luna
# Cheap model for file classification (default openai/gpt-5-nano)
NOTETHING_CHEAP_MODEL=openai/gpt-5-nano

# AgentMail (https://agentmail.to)
AGENTMAIL_API_KEY=
# Inbox id/address to send from. Leave blank and run `pnpm inbox` to create one.
AGENTMAIL_INBOX=
# Where study sessions are emailed
STUDENT_EMAIL=
# Your name, so files like Jane_Doe_PS1.pdf are recognized as your own submitted work
STUDENT_NAME=

# Neon Postgres connection string
DATABASE_URL=
# Optional: Neon branching for demo mode (pnpm demo:snapshot / demo:reset / demo:off).
# API key: Neon Console -> Account settings -> API keys. Project ID: Neon Console -> your project -> Settings.
# NEON_API_KEY=
# NEON_PROJECT_ID=
# Written by `pnpm demo:reset`, removed by `pnpm demo:off`. Overrides DATABASE_URL while set.
# DEMO_DATABASE_URL=

# Obsidian vault output dir (default ./vault). Point at a real vault to see notes live.
VAULT_DIR=
# Optional: the name of that Obsidian vault. If set, coach emails link each note with obsidian://open?vault=...
OBSIDIAN_VAULT=
# Local hour (0-23) study sessions are scheduled for
STUDY_HOUR=18

# Lecture videos are transcribed locally with uv + faster-whisper by default.
# Optional: transcribe on a remote box over SSH instead (python with faster-whisper + yt-dlp there)
TRANSCRIBE_SSH_HOST=
TRANSCRIBE_PYTHON=~/notething-venv/bin/python
WHISPER_MODEL=small
